{
  "name": "bworlds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev -w @bworlds/app",
    "build": "npm run build -w @bworlds/app",
    "build:analyze": "npm run build:analyze -w @bworlds/app",
    "depcruise": "npm exec -- depcruise --config .dependency-cruiser.mjs apps packages",
    "typecheck": "npm exec -- tsc --noEmit",
    "typecheck:strict": "npm exec -- tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip --no-progress",
    "security": "# npm audit --audit-level=high",
    "test": "node ./scripts/vitest-supervisor.mjs --suite-mode fast",
    "test:fast": "node ./scripts/vitest-supervisor.mjs --suite-mode fast",
    "test:all": "node ./scripts/vitest-supervisor.mjs --suite-mode all",
    "test:long": "node ./scripts/vitest-supervisor.mjs --suite-mode long",
    "test:hang-debug": "npm exec -- vitest run --reporter=verbose --maxWorkers=1 --minWorkers=1",
    "test:watch": "BWORLDS_VITEST_SUITE_MODE=fast vitest",
    "test:watch:all": "BWORLDS_VITEST_SUITE_MODE=all vitest",
    "test:watch:long": "BWORLDS_VITEST_SUITE_MODE=long vitest",
    "coverage": "vitest run --coverage",
    "format:fix": "prettier --write .",
    "format": "prettier --check .",
    "check": "npm run format && npm run lint && npm run depcruise && npm run knip && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "knip": "^6.32.1",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
